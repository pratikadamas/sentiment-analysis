# ==============================================================================
# Sentiment Pulse - Environment Configuration Template (.env.example)
# Copy this file to .env and configure values appropriate for your environment.
# ==============================================================================

# Application Configuration
APP_NAME=Sentiment Pulse
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=false

# Database Configuration
# Local SQLite default: sqlite:///./sentiment.db
# Production PostgreSQL example: postgresql+psycopg://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./sentiment.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security & Authentication (Generate using: openssl rand -hex 32)
JWT_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cookie Configuration
COOKIE_NAME=access_token
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# CORS Configuration (comma-separated list of allowed web origins or * in dev)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://sentiment-pulse-app.onrender.com

# Rate Limiting (in-memory per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=15
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60
RATE_LIMIT_RESEND_MAX=5
RATE_LIMIT_RESEND_WINDOW_SECONDS=60

# Email Delivery & SMTP Configuration
# In development/test: leave SMTP_HOST empty to operate in simulation mode
# In production (SendGrid, Mailgun, Amazon SES, Brevo, Resend, or custom SMTP):
APP_BASE_URL=https://sentiment-pulse-app.onrender.com
EMAIL_VERIFICATION_EXPIRE_MINUTES=30
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=noreply@sentimentpulse.com
SMTP_FROM_NAME=SentimentPulse

# Batch & CSV Import Controls
MAX_BATCH_SIZE=50
MAX_IMPORT_FILE_SIZE_BYTES=5242880
MAX_IMPORT_ROWS=5000
IMPORT_CHUNK_SIZE=100
